# Cloudflare Tunnel 配置模板（复制为 cloudflared.yml 并填入你的值；真实文件不入库）
# tunnel: <你的 Tunnel 名>
tunnel: <tunnel-uuid>
credentials-file: ~/.cloudflared/<tunnel-uuid>.json

originRequest:
  connectTimeout: 30s
  tcpKeepAlive: 30s
  keepAliveTimeout: 90s
  keepAliveConnections: 100
  noHappyEyeballs: true
  disableChunkedEncoding: false

ingress:
  # 终端（WebSocket）：必须带 /term 前缀
  - hostname: <你的域名>
    path: ^/term/?.*
    service: http://127.0.0.1:7681
    originRequest:
      http2Origin: false
  # 会话管理首页与 API
  - hostname: <你的域名>
    service: http://127.0.0.1:7690
    originRequest:
      http2Origin: false
  - service: http_status:404
