# ttyd Basic Auth（必填）
TTYD_USER=admin
TTYD_PASSWORD=change-me-to-a-strong-password


# 本机监听（0.0.0.0=同时对 loopback 与局域网开放；经 Cloudflare Tunnel 对外，局域网走明文 HTTP 直连）
# 若只想经隧道对外、不开局域网直连，改回 127.0.0.1
TTYD_HOST=0.0.0.0
TTYD_PORT=7681
TTYD_BASE_PATH=/term

# 会话管理页
MANAGE_HOST=0.0.0.0
MANAGE_PORT=7690

# 会话一律走 tmux（断线保留）；用管理页创建/停止多会话
USE_TMUX=1
TMUX_SESSION=web-term
LOGIN_SHELL=/bin/zsh

# Cloudflare 域名（文档用）
PUBLIC_HOST=term.example.com

# 浏览器终端保留约多少页输出供滚轮回看（本地 scrollback，不经公网）
# 这是「全局默认」的初始值；管理页改过之后以 run/scrollback-pages 为准（无需改这里、无需重启）
SCROLLBACK_PAGES=30

# 新建会话默认工作目录（新建时仍可指定任意已存在的目录）
SESSION_DEFAULT_PATH=/Users/YOUR_USER

# 自动更新：定期从 GitHub 拉取，重启后健康检查；失败自动回滚（最多 N 个版本）
# 1=启用定时器；0=只允许手动执行 bin/auto-update.py
AUTO_UPDATE_ENABLED=1
AUTO_UPDATE_REMOTE=origin
AUTO_UPDATE_BRANCH=main
# 检查间隔（分钟，装定时器时读取）
AUTO_UPDATE_INTERVAL_MIN=15
# 静默期（分钟）：每次更新/回滚后至少等这么久才再次动作
AUTO_UPDATE_COOLDOWN_MIN=30
# 回滚时最多往前尝试多少个版本
AUTO_UPDATE_MAX_ROLLBACK=5
# 每次重启后等待服务健康的秒数
AUTO_UPDATE_HEALTH_TIMEOUT=90

# 公共文件夹（临时公共网盘）：登录用户共用；开启公网访问后生成 /p/<token>，
# 任何人无需登录即可上传/下载；关闭后链接立即失效
# 存储目录（默认 <项目>/run/public-drive）
# PUBLIC_DRIVE_DIR=run/public-drive
# 单文件上限 / 总容量上限（MB）
PUBLIC_DRIVE_MAX_FILE_MB=2048
PUBLIC_DRIVE_QUOTA_MB=4096
# 每月上传+下载总流量上限（MB，0=不限制；页面里可随时调整，调整后以 state 为准）
PUBLIC_DRIVE_MONTHLY_LIMIT_MB=10240

# 登录失败限速（可选，下为默认值）：按来源 IP / 账号分别计数，窗口内失败达上限即锁定，锁定期内连正确密码也拒绝
# LOGIN_FAIL_WINDOW=600      统计窗口（秒）
# LOGIN_FAIL_MAX_IP=10       单 IP 窗口内最多失败次数
# LOGIN_FAIL_MAX_USER=30     单账号窗口内最多失败次数
# LOGIN_LOCK_SEC=900         锁定时长（秒）
