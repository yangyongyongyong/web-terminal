# ttyd Basic Auth（必填）
TTYD_USER=admin
TTYD_PASSWORD=change-me-to-a-strong-password

# 会话进入 PIN（必填；打开/新建终端时校验，勿与 Basic Auth 相同）
SESSION_PIN=change-me

# 本机监听（仅 loopback，经 Cloudflare Tunnel 对外）
TTYD_HOST=127.0.0.1
TTYD_PORT=7681
TTYD_BASE_PATH=/term

# 会话管理页
MANAGE_HOST=127.0.0.1
MANAGE_PORT=7690

# 会话一律走 tmux（断线保留）；用管理页创建/停止多会话
USE_TMUX=1
TMUX_SESSION=web-term
LOGIN_SHELL=/bin/zsh

# Cloudflare 域名（文档用）
PUBLIC_HOST=term.lucadesign.uk

# 浏览器终端保留约多少页输出供滚轮回看（本地 scrollback，不经公网）
SCROLLBACK_PAGES=30

# 终端工作目录限制（新建会话 cwd 必须在此根下）
SESSION_PATH_ROOT=/Users/YOUR_USER
# 新建会话默认工作目录
SESSION_DEFAULT_PATH=/Users/YOUR_USER
